data "oci_identity_domains_policies" "identity_domains_policies_lookup" {
  for_each = var.identity_domains_policies_lookup

  idcs_endpoint                = each.value.idcs_endpoint
  attribute_sets               = each.value.attribute_sets
  attributes                   = each.value.attributes
  authorization                = each.value.authorization
  compartment_id               = each.value.compartment_id
  policy_count                 = each.value.policy_count
  policy_filter                = each.value.policy_filter
  resource_type_schema_version = each.value.resource_type_schema_version
  sort_by                      = each.value.sort_by
  sort_order                   = each.value.sort_order
  start_index                  = each.value.start_index
}

